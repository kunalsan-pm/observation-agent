# Copy to .env (loaded by nothing automatically — export these, or use your own loader).
#
# Reaching a model: set EITHER an API key, OR log in to the Claude Code CLI
# (`claude`, then /login) to use the Claude Agent SDK backend. The app
# auto-detects and prefers the API key when present.

# ANTHROPIC_API_KEY=sk-ant-...

# Model for the Anthropic API backend. claude-sonnet-5 is cheaper and still strong.
# OBSERVATION_AGENT_MODEL=claude-opus-5

# Tool-use turn ceiling per question.
# OBSERVATION_AGENT_MAX_TURNS=24

# Web server bind. Loopback by default — the app has no auth.
# OBSERVATION_AGENT_HOST=127.0.0.1
# OBSERVATION_AGENT_PORT=8080

# The as-of anchor. The fixture data is built around 2026-05-12; every relative
# window ("last 30 days", "past due") is measured from the end of this day.
# OBSERVATIONS_TODAY=2026-05-12

# Point the MCP server at a different dataset directory.
# OBSERVATIONS_DATA_DIR=./data
